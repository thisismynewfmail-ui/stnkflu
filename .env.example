# FLYLAB reads no credentials and contacts no service on your behalf.
# These two variables only move files around; both are optional.

# Where projects, saved models and settings live.
# Default: ~/.flylab
# FLYLAB_HOME=/home/pi/flylab

# Which dataset directory the simulator loads by default. The interface sets
# this for you when you load a dataset; set it here to override.
# FLYLAB_DATA=/home/pi/flylab/datasets/malecns-v1

# Where the compiled simulation kernel is cached.
# Default: <dataset directory>/cache
# FLYLAB_CACHE=/var/tmp/flylab-cache
